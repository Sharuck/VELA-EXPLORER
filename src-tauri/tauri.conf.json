{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vela Explorer",
  "version": "0.3.0",
  "identifier": "com.vela.explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' data: asset:; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "Vela Explorer",
        "width": 1320,
        "height": 820,
        "minWidth": 850,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 22
        },
        "backgroundColor": "#f7f8fb"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
